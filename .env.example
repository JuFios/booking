# App
NODE_ENV=development
PORT=3000

# Database (used by docker-compose to create the Postgres container)
POSTGRES_USER=booking
POSTGRES_PASSWORD=booking
POSTGRES_DB=booking

# Database connection string for the app
DATABASE_URL=postgresql://booking:booking@localhost:5432/booking

# JWT: secrets must be at least 32 characters and different from each other
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
# Token lifetimes in seconds: 15 minutes and 7 days
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# Admin account created by the seed
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
